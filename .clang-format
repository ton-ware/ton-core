---
BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
UseTab: Never
TabWidth: 4
ColumnLimit: 100
PointerAlignment: Left
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
MaxEmptyLinesToKeep: 1
IndentCaseLabels: true
SortIncludes: CaseSensitive
AlignTrailingComments: true
...
